cask "handypos" do
  arch arm: "aarch64", intel: "x64"

  version "$VERSION"

  on_macos do
    sha256 arm:   "$MAC_ARM_SHA256",
           intel: "$MAC_INTEL_SHA256"

    url "https://github.com/mattsverse/handypos/releases/download/v#{version}/HandyPOS_#{version}_#{arch}.dmg"

    app "HandyPOS.app"
  end

  on_linux do
    sha256 "$LINUX_SHA256"

    url "https://github.com/mattsverse/handypos/releases/download/v#{version}/handypos_#{version}_x86_64.AppImage"

    depends_on arch: :x86_64

    app_image "handypos_#{version}_x86_64.AppImage", target: "HandyPOS.AppImage"
    binary "handypos_#{version}_x86_64.AppImage", target: "handypos"
  end

  name "HandyPOS"
  desc "Native workspace for local PostgreSQL containers"
  homepage "https://github.com/mattsverse/handypos"

  caveats <<~EOS
    HandyPOS requires the Docker CLI and a running local Docker daemon.
    The macOS app is ad-hoc signed and is not notarized.
    The Linux AppImage requires glibc 2.39 or newer, FUSE 2, and a Vulkan-capable graphics driver.
  EOS
end
